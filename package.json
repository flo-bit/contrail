{
  "name": "contrail-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "build:apps": "turbo run build",
    "test": "turbo run test",
    "test:built": "pnpm --filter @atmo-dev/contrail test:built",
    "bench": "node --no-warnings --experimental-strip-types apps/benchmark/src/bench.ts",
    "typecheck": "turbo run typecheck",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.30.1"
}
