{
  "name": "@atmo-dev/contrail",
  "version": "0.15.0",
  "description": "Index AT Protocol records with typed XRPC endpoints. Cloudflare Workers + D1, SvelteKit, Node.js.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./sqlite": {
      "types": "./dist/adapters/sqlite.d.ts",
      "import": "./dist/adapters/sqlite.js"
    },
    "./postgres": {
      "types": "./dist/adapters/postgres.d.ts",
      "import": "./dist/adapters/postgres.js"
    },
    "./workers": {
      "types": "./dist/workers/backfill.d.ts",
      "import": "./dist/workers/backfill.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./cli-config": {
      "types": "./dist/cli-config.d.ts",
      "import": "./dist/cli-config.js"
    },
    "./lexicons": {
      "types": "./dist/lexicons/index.d.ts",
      "import": "./dist/lexicons/index.js"
    }
  },
  "bin": {
    "contrail": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flo-bit/contrail.git",
    "directory": "packages/contrail"
  },
  "keywords": [
    "atproto",
    "bluesky",
    "cloudflare",
    "d1",
    "indexer",
    "xrpc"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:built": "node tests/built-sqlite.mjs && node tests/built-lexicons.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.4",
    "@atcute/cbor": "^2.3.6",
    "@atcute/cid": "2.4.2",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/jetstream": "^2.0.2",
    "@atcute/lex-cli": "^3.2.1",
    "@atcute/lexicon-doc": "3.0.2",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/tid": "1.1.4",
    "@atcute/xrpc-server": "^2.0.2",
    "cac": "^7.0.0",
    "hono": "^4.13.0",
    "jiti": "^2.7.0",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@atcute/crypto": "2.4.4",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "pg": "^8.22.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "wrangler": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "license": "MIT"
}
