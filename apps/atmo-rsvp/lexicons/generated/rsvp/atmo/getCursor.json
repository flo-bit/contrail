{
  "lexicon": 1,
  "id": "rsvp.atmo.getCursor",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the committed primary ordered-source position",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "position": {
              "type": "ref",
              "ref": "#sourcePosition"
            },
            "updatedAt": {
              "type": "integer"
            },
            "updatedAtDate": {
              "type": "string",
              "format": "datetime"
            }
          }
        }
      }
    },
    "sourcePosition": {
      "type": "object",
      "required": [
        "source",
        "epoch",
        "cursor"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "epoch": {
          "type": "string"
        },
        "cursor": {
          "type": "string"
        }
      }
    }
  }
}
